// RuMax Global Digital University — data model
// ---------------------------------------------------------------------------
// A narrative walkthrough of these tables, plus a rendered ER diagram, lives in
// docs/DATA-MODEL.md. Conventions used throughout:
//   * every table carries createdAt/updatedAt
//   * user-facing identifiers (studentNumber, invoiceNumber, serial) are separate
//     from primary keys so they can be re-issued without breaking foreign keys
//   * deletes cascade only where the child has no meaning without its parent;
//     academic records (grades, payments, certificates) are never cascade-deleted

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection used by the running application. On Supabase this is the
  // transaction pooler (port 6543) with `?pgbouncer=true&connection_limit=1`.
  url      = env("DATABASE_URL")
  // Direct, unpooled connection used only by `prisma migrate` and `prisma db push`.
  // Migrations issue statements a transaction pooler cannot carry (advisory locks,
  // CREATE TYPE outside a transaction), so running them through the pooler fails in
  // ways that look like a hung connection. Prisma has no fallback for this, so
  // DIRECT_URL must always be set — point it at DATABASE_URL when there is no pooler
  // (plain local Postgres, Docker Compose, CI). Every config in this repo does.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

enum Role {
  APPLICANT
  STUDENT
  LECTURER
  REGISTRAR
  FINANCE
  ADMIN
  ALUMNI
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  GRADUATED
  WITHDRAWN
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          Role       @default(APPLICANT)
  status        UserStatus @default(PENDING)

  // Profile
  phone         String?
  avatarUrl     String?
  bio           String?
  country       String?
  city          String?
  dateOfBirth   DateTime?
  gender        String?
  locale        String     @default("en")
  timezone      String     @default("UTC")

  // Academic identity (students only)
  studentNumber String?    @unique
  staffNumber   String?    @unique
  programId     String?
  program       Program?   @relation(fields: [programId], references: [id])
  yearOfStudy   Int?
  admittedAt    DateTime?
  graduatedAt   DateTime?

  // Security
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  lastLoginAt      DateTime?
  failedLogins     Int       @default(0)
  lockedUntil      DateTime?
  passwordChangedAt DateTime @default(now())

  // Relations
  sessions           Session[]
  auditLogs          AuditLog[]
  applications       Application[]
  registrations      Registration[]
  taughtCourses      Course[]           @relation("CourseLecturer")
  submissions        Submission[]
  quizAttempts       QuizAttempt[]
  grades             Grade[]
  attendance         AttendanceRecord[]
  invoices           Invoice[]
  payments           Payment[]
  certificates       Certificate[]
  sentMessages       Message[]          @relation("MessageSender")
  receivedMessages   Message[]          @relation("MessageRecipient")
  notifications      Notification[]
  forumPosts         ForumPost[]
  forumThreads       ForumThread[]
  announcements      Announcement[]
  publications       Publication[]
  researchProjects   ResearchProject[]  @relation("ResearchLead")
  loans              LibraryLoan[]
  tutorConversations TutorConversation[]
  headedFaculties    Faculty[]          @relation("FacultyDean")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role, status])
  @@index([programId])
}

/// Server-side session record. The JWT is stateless, but keeping a row per session
/// is what makes "sign out everywhere" and forced revocation on role change possible.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenId   String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Academic structure
// ---------------------------------------------------------------------------

model Faculty {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String
  imageUrl    String?
  deanId      String?
  dean        User?        @relation("FacultyDean", fields: [deanId], references: [id])
  departments Department[]
  programs    Program[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Department {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String
  facultyId   String
  faculty     Faculty   @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  programs    Program[]
  courses     Course[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([facultyId])
}

enum ProgramLevel {
  CERTIFICATE
  DIPLOMA
  UNDERGRADUATE
  MASTERS
  PHD
  PROFESSIONAL
  SHORT_COURSE
  EXECUTIVE
  MOOC
}

enum DeliveryMode {
  ONLINE
  BLENDED
  SELF_PACED
}

model Program {
  id              String       @id @default(cuid())
  slug            String       @unique
  code            String       @unique
  title           String
  level           ProgramLevel
  mode            DeliveryMode @default(ONLINE)
  summary         String
  description     String
  durationMonths  Int
  totalCredits    Int
  tuitionPerYear  Decimal      @db.Decimal(12, 2)
  currency        String       @default("USD")
  entryRequirements String[]
  careerOutcomes  String[]
  accreditation   String?
  imageUrl        String?
  featured        Boolean      @default(false)
  published       Boolean      @default(true)

  facultyId    String
  faculty      Faculty     @relation(fields: [facultyId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  courses      ProgramCourse[]
  applications Application[]
  students     User[]
  certificates Certificate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([level, published])
  @@index([facultyId])
}

/// Join table carrying curriculum metadata: which year/semester a course sits in
/// and whether it is core or elective for that specific program.
model ProgramCourse {
  id         String  @id @default(cuid())
  programId  String
  program    Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  year       Int     @default(1)
  semester   Int     @default(1)
  isCore     Boolean @default(true)

  @@unique([programId, courseId])
  @@index([courseId])
}

model Course {
  id          String  @id @default(cuid())
  slug        String  @unique
  code        String  @unique
  title       String
  description String
  credits     Int     @default(3)
  level       Int     @default(100)
  syllabusUrl String?
  imageUrl    String?
  published   Boolean @default(true)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  lecturerId   String?
  lecturer     User?       @relation("CourseLecturer", fields: [lecturerId], references: [id])

  prerequisites CoursePrerequisite[] @relation("CourseOf")
  requiredBy    CoursePrerequisite[] @relation("PrerequisiteOf")

  programs      ProgramCourse[]
  modules       CourseModule[]
  registrations Registration[]
  assignments   Assignment[]
  quizzes       Quiz[]
  liveSessions  LiveSession[]
  attendance    AttendanceRecord[]
  grades        Grade[]
  forumThreads  ForumThread[]
  timetable     TimetableSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([lecturerId])
}

model CoursePrerequisite {
  id             String @id @default(cuid())
  courseId       String
  course         Course @relation("CourseOf", fields: [courseId], references: [id], onDelete: Cascade)
  prerequisiteId String
  prerequisite   Course @relation("PrerequisiteOf", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([courseId, prerequisiteId])
}

model CourseModule {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  summary     String?
  position    Int      @default(0)
  lessons     Lesson[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId])
}

enum LessonType {
  VIDEO
  READING
  PDF
  SLIDES
  AUDIO
  LAB
  SIMULATION
  LIVE
}

model Lesson {
  id            String       @id @default(cuid())
  moduleId      String
  module        CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title         String
  type          LessonType   @default(VIDEO)
  contentUrl    String?
  body          String?
  durationMins  Int          @default(0)
  position      Int          @default(0)
  downloadable  Boolean      @default(true)
  progress      LessonProgress[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([moduleId])
}

model LessonProgress {
  id          String    @id @default(cuid())
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId      String
  completed   Boolean   @default(false)
  secondsSpent Int      @default(0)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([lessonId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Terms, registration, timetable, attendance
// ---------------------------------------------------------------------------

model AcademicTerm {
  id             String   @id @default(cuid())
  name           String   @unique
  academicYear   String
  startDate      DateTime
  endDate        DateTime
  registrationOpens  DateTime
  registrationCloses DateTime
  examStart      DateTime?
  examEnd        DateTime?
  isCurrent      Boolean  @default(false)

  registrations Registration[]
  grades        Grade[]
  invoices      Invoice[]
  timetable     TimetableSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
  COMPLETED
}

model Registration {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  termId    String
  term      AcademicTerm       @relation(fields: [termId], references: [id])
  status    RegistrationStatus @default(PENDING)
  approvedById String?
  approvedAt   DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([userId, courseId, termId])
  @@index([courseId, termId])
  @@index([userId, status])
}

model TimetableSlot {
  id        String       @id @default(cuid())
  courseId  String
  course    Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  termId    String
  term      AcademicTerm @relation(fields: [termId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0 = Sunday
  startTime String // "14:00" stored in UTC; rendered in the viewer's timezone
  endTime   String
  location  String   @default("Virtual Classroom")
  createdAt DateTime @default(now())

  @@index([courseId])
  @@index([termId, dayOfWeek])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model AttendanceRecord {
  id       String           @id @default(cuid())
  userId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  date     DateTime
  status   AttendanceStatus @default(PRESENT)
  note     String?
  createdAt DateTime        @default(now())

  @@unique([userId, courseId, date])
  @@index([courseId, date])
}

enum LiveProvider {
  ZOOM
  TEAMS
  GOOGLE_MEET
  DAILY
  AGORA
}

model LiveSession {
  id          String       @id @default(cuid())
  courseId    String
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  provider    LiveProvider @default(ZOOM)
  joinUrl     String
  recordingUrl String?
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime     @default(now())

  @@index([courseId, startsAt])
}

// ---------------------------------------------------------------------------
// Assessment
// ---------------------------------------------------------------------------

model Assignment {
  id           String   @id @default(cuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title        String
  instructions String
  maxScore     Int      @default(100)
  weight       Float    @default(0.1)
  dueAt        DateTime
  allowLate    Boolean  @default(false)
  published    Boolean  @default(true)
  submissions  Submission[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([courseId, dueAt])
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  LATE
  GRADED
  RETURNED
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  content      String?
  fileUrl      String?
  status       SubmissionStatus @default(DRAFT)
  submittedAt  DateTime?
  score        Float?
  feedback     String?
  gradedById   String?
  gradedAt     DateTime?
  /// Similarity score (0-100) returned by the plagiarism provider. Null = not checked.
  similarity   Float?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([assignmentId, userId])
  @@index([userId, status])
}

enum QuizType {
  PRACTICE
  QUIZ
  MIDTERM
  FINAL_EXAM
}

model Quiz {
  id             String     @id @default(cuid())
  courseId       String
  course         Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  type           QuizType   @default(QUIZ)
  durationMins   Int        @default(30)
  maxAttempts    Int        @default(1)
  passMark       Int        @default(50)
  weight         Float      @default(0.1)
  shuffle        Boolean    @default(true)
  /// Number of questions drawn at random from the bank; 0 = serve every question.
  questionsToServe Int      @default(0)
  proctored      Boolean    @default(false)
  lockdownBrowser Boolean   @default(false)
  opensAt        DateTime?
  closesAt       DateTime?
  published      Boolean    @default(false)
  questions      Question[]
  attempts       QuizAttempt[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([courseId, type])
}

enum QuestionType {
  MULTIPLE_CHOICE
  MULTIPLE_SELECT
  TRUE_FALSE
  SHORT_ANSWER
  ESSAY
}

model Question {
  id          String       @id @default(cuid())
  quizId      String
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type        QuestionType @default(MULTIPLE_CHOICE)
  prompt      String
  points      Int          @default(1)
  position    Int          @default(0)
  explanation String?
  options     QuestionOption[]
  answers     Answer[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([quizId])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  position   Int      @default(0)

  @@index([questionId])
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
  ABANDONED
  FLAGGED
}

model QuizAttempt {
  id          String        @id @default(cuid())
  quizId      String
  quiz        Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  attemptNo   Int           @default(1)
  status      AttemptStatus @default(IN_PROGRESS)
  score       Float?
  maxScore    Float?
  startedAt   DateTime      @default(now())
  submittedAt DateTime?
  /// Ordered question ids for this attempt — persisted so a refresh cannot reshuffle
  /// the paper mid-exam and so proctoring reports are reproducible.
  servedOrder String[]
  /// Proctoring events (tab blur, multiple faces, no face) captured during the attempt.
  proctorFlags Json?
  answers     Answer[]

  @@unique([quizId, userId, attemptNo])
  @@index([userId, status])
}

model Answer {
  id         String      @id @default(cuid())
  attemptId  String
  attempt    QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  /// Selected option ids for choice questions.
  selected   String[]
  text       String?
  score      Float?
  feedback   String?
  updatedAt  DateTime    @updatedAt

  @@unique([attemptId, questionId])
}

model Grade {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId     String
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  termId       String
  term         AcademicTerm @relation(fields: [termId], references: [id])
  /// Percentage 0-100 aggregated from the course's weighted assessments.
  score        Float
  letter       String
  gradePoint   Float
  credits      Int
  published    Boolean      @default(false)
  publishedAt  DateTime?
  appealNote   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([userId, courseId, termId])
  @@index([userId, published])
}

// ---------------------------------------------------------------------------
// Admissions
// ---------------------------------------------------------------------------

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  INTERVIEW
  OFFER_MADE
  ACCEPTED
  DECLINED
  REJECTED
  ENROLLED
  WITHDRAWN
}

model Application {
  id        String            @id @default(cuid())
  reference String            @unique
  userId    String?
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  programId String
  program   Program           @relation(fields: [programId], references: [id])
  status    ApplicationStatus @default(DRAFT)

  firstName   String
  lastName    String
  email       String
  phone       String?
  dateOfBirth DateTime?
  nationality String?
  country     String?
  gender      String?

  highestQualification String?
  institution          String?
  graduationYear       Int?
  gpa                  String?
  personalStatement    String?
  intakeTerm           String?
  fundingSource        String?

  documents       ApplicationDocument[]
  reviewNotes     String?
  reviewedById    String?
  reviewedAt      DateTime?
  interviewAt     DateTime?
  offerIssuedAt   DateTime?
  offerExpiresAt  DateTime?
  applicationFeePaid Boolean @default(false)

  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([programId])
  @@index([email])
}

enum DocumentType {
  PASSPORT_PHOTO
  NATIONAL_ID
  PASSPORT
  ACADEMIC_CERTIFICATE
  TRANSCRIPT
  REFERENCE_LETTER
  RECOMMENDATION_LETTER
  CV
  PERSONAL_STATEMENT
  PROOF_OF_PAYMENT
  OTHER
}

model ApplicationDocument {
  id            String       @id @default(cuid())
  applicationId String
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          DocumentType
  fileName      String
  fileUrl       String
  fileSize      Int          @default(0)
  mimeType      String       @default("application/pdf")
  verified      Boolean      @default(false)
  uploadedAt    DateTime     @default(now())

  @@index([applicationId])
}

// ---------------------------------------------------------------------------
// Finance
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  termId        String?
  term          AcademicTerm? @relation(fields: [termId], references: [id])
  description   String
  amount        Decimal       @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(12, 2)
  currency      String        @default("USD")
  status        InvoiceStatus @default(ISSUED)
  dueDate       DateTime
  items         Json?
  payments      Payment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId, status])
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  FLUTTERWAVE
  PAYSTACK
  BANK_TRANSFER
  AIRTEL_MONEY
  TNM_MPAMBA
  MANUAL
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id          String          @id @default(cuid())
  reference   String          @unique
  invoiceId   String?
  invoice     Invoice?        @relation(fields: [invoiceId], references: [id])
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Decimal         @db.Decimal(12, 2)
  currency    String          @default("USD")
  provider    PaymentProvider @default(STRIPE)
  status      PaymentStatus   @default(PENDING)
  providerRef String?
  receiptUrl  String?
  metadata    Json?
  paidAt      DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId, status])
  @@index([invoiceId])
}

model Scholarship {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String
  coveragePct  Int      @default(50)
  amount       Decimal? @db.Decimal(12, 2)
  currency     String   @default("USD")
  eligibility  String[]
  deadline     DateTime
  slots        Int      @default(10)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Credentials
// ---------------------------------------------------------------------------

enum CertificateType {
  DEGREE
  DIPLOMA
  CERTIFICATE
  TRANSCRIPT
  COMPLETION
}

model Certificate {
  id          String          @id @default(cuid())
  /// Public verification code printed on the certificate and encoded in its QR code.
  serial      String          @unique
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  programId   String?
  program     Program?        @relation(fields: [programId], references: [id])
  type        CertificateType @default(DEGREE)
  title       String
  classification String?
  issuedAt    DateTime        @default(now())
  expiresAt   DateTime?
  revoked     Boolean         @default(false)
  revokedReason String?
  /// SHA-256 of the canonical certificate payload, anchored on-chain in production.
  documentHash String
  blockchainTx String?
  pdfUrl      String?
  verifications CertificateVerification[]
  createdAt   DateTime        @default(now())

  @@index([userId])
}

model CertificateVerification {
  id            String      @id @default(cuid())
  certificateId String
  certificate   Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  verifierName  String?
  verifierEmail String?
  ip            String?
  createdAt     DateTime    @default(now())

  @@index([certificateId])
}

// ---------------------------------------------------------------------------
// Communication & community
// ---------------------------------------------------------------------------

enum AnnouncementAudience {
  ALL
  STUDENTS
  LECTURERS
  STAFF
  ALUMNI
  APPLICANTS
}

model Announcement {
  id        String               @id @default(cuid())
  title     String
  body      String
  audience  AnnouncementAudience @default(ALL)
  pinned    Boolean              @default(false)
  authorId  String?
  author    User?                @relation(fields: [authorId], references: [id], onDelete: SetNull)
  publishedAt DateTime           @default(now())
  expiresAt DateTime?
  createdAt DateTime             @default(now())

  @@index([audience, publishedAt])
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User     @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  subject     String
  body        String
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([recipientId, readAt])
  @@index([senderId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  link      String?
  category  String   @default("general")
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
}

model ForumThread {
  id        String   @id @default(cuid())
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  body      String
  pinned    Boolean  @default(false)
  locked    Boolean  @default(false)
  views     Int      @default(0)
  posts     ForumPost[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, updatedAt])
}

model ForumPost {
  id        String      @id @default(cuid())
  threadId  String
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  isAnswer  Boolean     @default(false)
  upvotes   Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([threadId, createdAt])
}

/// A conversation with the AI tutor. Kept per user so the assistant can carry context
/// and so academic-integrity reviews have a record of what help was given.
model TutorConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("New conversation")
  courseId  String?
  messages  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

// ---------------------------------------------------------------------------
// Library, research, careers, content
// ---------------------------------------------------------------------------

enum LibraryItemType {
  BOOK
  EBOOK
  JOURNAL
  RESEARCH_PAPER
  PAST_PAPER
  MAGAZINE
  VIDEO
  AUDIOBOOK
}

model LibraryItem {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  authors     String[]
  type        LibraryItemType @default(EBOOK)
  isbn        String?
  doi         String?
  publisher   String?
  year        Int?
  subjects    String[]
  abstract    String?
  fileUrl     String?
  coverUrl    String?
  copies      Int             @default(1)
  available   Int             @default(1)
  downloadable Boolean        @default(true)
  loans       LibraryLoan[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([type])
}

model LibraryLoan {
  id         String    @id @default(cuid())
  itemId     String
  item       LibraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  borrowedAt DateTime  @default(now())
  dueAt      DateTime
  returnedAt DateTime?

  @@index([userId, returnedAt])
}

enum ResearchStatus {
  PROPOSED
  ACTIVE
  COMPLETED
  SUSPENDED
}

model ResearchProject {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  abstract    String
  status      ResearchStatus @default(ACTIVE)
  leadId      String?
  lead        User?          @relation("ResearchLead", fields: [leadId], references: [id], onDelete: SetNull)
  fundingBody String?
  fundingAmount Decimal?     @db.Decimal(12, 2)
  startDate   DateTime
  endDate     DateTime?
  keywords    String[]
  publications Publication[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Publication {
  id        String   @id @default(cuid())
  title     String
  abstract  String?
  journal   String?
  doi       String?  @unique
  year      Int
  url       String?
  citations Int      @default(0)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  projectId String?
  project   ResearchProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([year])
}

enum PostCategory {
  NEWS
  BLOG
  EVENT
  PRESS
}

model Post {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  excerpt     String
  body        String
  category    PostCategory @default(NEWS)
  coverUrl    String?
  authorName  String       @default("University Communications")
  tags        String[]
  published   Boolean      @default(true)
  publishedAt DateTime     @default(now())
  eventStart  DateTime?
  eventEnd    DateTime?
  location    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([category, publishedAt])
}

enum JobType {
  INTERNSHIP
  GRADUATE
  FULL_TIME
  PART_TIME
  CONTRACT
}

model JobPosting {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  employer    String
  location    String
  type        JobType  @default(GRADUATE)
  description String
  requirements String[]
  salaryRange String?
  applyUrl    String?
  remote      Boolean  @default(true)
  closesAt    DateTime
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type, closesAt])
}

model Partner {
  id       String  @id @default(cuid())
  name     String
  category String  @default("Academic")
  country  String?
  logoUrl  String?
  website  String?
  summary  String?
  createdAt DateTime @default(now())
}

model FaqEntry {
  id       String @id @default(cuid())
  question String
  answer   String
  category String @default("General")
  position Int    @default(0)
}

model ContactEnquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([handled, createdAt])
}

/// Key/value store for tenant-wide settings edited from the admin System Settings
/// screen (site title, maintenance mode, fee deadlines, feature flags…).
model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
