# ---------------------------------------------------------------------------
# RuMax Global Digital University — environment configuration
# Copy to .env.local for development, or supply as secrets in production.
# ---------------------------------------------------------------------------

# Core -----------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="RuMax Global Digital University"

# Show the one-click demonstration account shortcuts on the sign-in page.
# Off unless this is exactly "true". Leave it unset on anything public: the shortcuts
# advertise which addresses exist, including the administrator's.
NEXT_PUBLIC_SHOW_DEMO_LOGINS=

# Database -------------------------------------------------------------------
# Two URLs are needed whenever a connection pooler sits in front of Postgres.
#
#   DATABASE_URL  the application's connection — pooled
#   DIRECT_URL    used only by `prisma migrate` / `db push` — never pooled
#
# Migrations take advisory locks and run DDL a transaction pooler cannot carry, so
# pointing DIRECT_URL at a pooler makes them hang rather than fail. `npm run setup`
# checks for this.
#
# --- Supabase (Project settings → Database → Connection string) ---
# Transaction pooler, port 6543 — note the required pgbouncer flags:
#   DATABASE_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Session pooler, port 5432 — IPv4-friendly, use this for migrations:
#   DIRECT_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres"
#
# --- Local Postgres or Docker Compose (no pooler: both point at the same place) ---
DATABASE_URL="postgresql://rumax:rumax@localhost:5432/rumax?schema=public"
DIRECT_URL="postgresql://rumax:rumax@localhost:5432/rumax?schema=public"

# Apply migrations, and seed if the database is empty, as part of `npm run build`.
# For platforms with no shell (deploying straight from Git to Vercel). Off unless
# exactly "true". Safe to leave on: the seed only runs into an empty database.
SETUP_DATABASE_ON_BUILD=

# Cache / queues (optional in development; the app degrades to in-process cache)
REDIS_URL="redis://localhost:6379"

# Auth -----------------------------------------------------------------------
# Generate with:  openssl rand -base64 48
AUTH_SECRET="change-me-to-a-48-byte-random-string-before-deploying"
AUTH_TOKEN_TTL_HOURS=12
AUTH_COOKIE_NAME=rumax_session

# OAuth (optional — the buttons are hidden entirely when unset).
# Redirect URIs are derived from NEXT_PUBLIC_SITE_URL and must match what you registered
# with the provider exactly:
#   <site>/api/auth/oauth/google/callback
#   <site>/api/auth/oauth/microsoft/callback
# See docs/OAUTH.md, including why Microsoft sign-in will not link to an existing account.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Object storage -------------------------------------------------------------
S3_REGION=eu-west-1
S3_BUCKET=rumax-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Payments -------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
FLUTTERWAVE_SECRET_KEY=
PAYSTACK_SECRET_KEY=
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
TNM_MPAMBA_API_KEY=

# Video conferencing ---------------------------------------------------------
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
DAILY_API_KEY=
AGORA_APP_ID=

# AI ------------------------------------------------------------------------
# Without a key the AI features fall back to a deterministic offline responder so
# the product still demonstrates end to end.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Communications -------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="RuMax University <no-reply@rumax.edu>"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Integrations ---------------------------------------------------------------
TURNITIN_API_KEY=
ORCID_CLIENT_ID=
CROSSREF_MAILTO=

# Seeding --------------------------------------------------------------------
# Password given to every demo account created by `npm run db:seed`.
#
# Leave it unset locally and the seed uses `rumax-local-dev`, which is fine for a
# throwaway database. SET IT for anything reachable from the internet: the seeded
# accounts include a full administrator, so the password is a real credential. With
# NODE_ENV=production and this unset, the seed generates a random one and prints it
# once rather than falling back to anything published.
SEED_PASSWORD=
