# ---------------------------------------------------------------------------
# RuMax Global Digital University — environment configuration
# Copy to .env.local for development, or supply as secrets in production.
# ---------------------------------------------------------------------------

# Core -----------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="RuMax Global Digital University"

# Database -------------------------------------------------------------------
DATABASE_URL="postgresql://rumax:rumax@localhost:5432/rumax?schema=public"

# Cache / queues (optional in development; the app degrades to in-process cache)
REDIS_URL="redis://localhost:6379"

# Auth -----------------------------------------------------------------------
# Generate with:  openssl rand -base64 48
AUTH_SECRET="change-me-to-a-48-byte-random-string-before-deploying"
AUTH_TOKEN_TTL_HOURS=12
AUTH_COOKIE_NAME=rumax_session

# OAuth (optional — sign-in falls back to email/password when unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Object storage -------------------------------------------------------------
S3_REGION=eu-west-1
S3_BUCKET=rumax-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Payments -------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
FLUTTERWAVE_SECRET_KEY=
PAYSTACK_SECRET_KEY=
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
TNM_MPAMBA_API_KEY=

# Video conferencing ---------------------------------------------------------
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
DAILY_API_KEY=
AGORA_APP_ID=

# AI ------------------------------------------------------------------------
# Without a key the AI features fall back to a deterministic offline responder so
# the product still demonstrates end to end.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Communications -------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="RuMax University <no-reply@rumax.edu>"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Integrations ---------------------------------------------------------------
TURNITIN_API_KEY=
ORCID_CLIENT_ID=
CROSSREF_MAILTO=

# Seeding --------------------------------------------------------------------
# Password given to every demo account created by `npm run db:seed`.
SEED_PASSWORD="RuMax#Demo2025"
